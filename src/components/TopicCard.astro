---
import type { Topic } from "@/content/courseData";
import { siteHref } from "@/utils/siteHref";

interface Props {
  topic: Topic;
  compact?: boolean;
}

const { topic, compact = false } = Astro.props;
---

<article class:list={["topic-card", compact && "compact"]}>
  <div class="topic-number">专题 {topic.number}</div>
  <h3><a href={siteHref(`/topics/${topic.slug}`)}>{topic.title}</a></h3>
  <p>{topic.summary}</p>
  <div class="tag-row">
    {topic.methods.slice(0, 3).map((method) => <span>{method}</span>)}
  </div>
</article>
