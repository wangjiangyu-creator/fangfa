const globalStyles = [
  {
    title: "GB/T 7714",
    region: "中国通用参考文献著录",
    source: "国家标准全文公开系统",
    url: "https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=7FA63E9BBA56E60471AEDAEBDE44B14C",
    summary: "《信息与文献 参考文献著录规则》是中国大陆学位论文、社科论文和综合性期刊常见的参考文献著录标准。它不专属于法学，但很适合课程论文、学位论文和跨学科论文的文末参考文献。",
    rules: ["常用顺序编码制或著者-出版年制，按学校或期刊要求选择。", "文献类型可用标识码，如专著 M、期刊 J、学位论文 D、报告 R、电子文献 EB/OL。", "中文学位论文和社科论文常用它整理文末参考文献，再配合法学脚注处理法律材料。"],
    examples: ["王名扬. 美国行政法[M]. 北京: 北京大学出版社, 2007.", "陈瑞华. 程序性制裁制度的法理学分析[J]. 中国法学, 2005(6): 153-163.", "中华人民共和国民法典[S]. 2020."]
  },
  {
