---
import BaseLayout from "@/layouts/BaseLayout.astro";

const chineseGuides = [
  {
    title: "中文法学引注的共通基准",
    source: "《法学引注手册》",
    url: "https://law.nankai.edu.cn/_upload/article/files/1a/dc/5322bd594000aaa39f8a79402595/f6116f14-503f-4901-83eb-9394b4b153e9.pdf",
    summary: "由中国法学会法学期刊研究会推荐，参与制定和使用单位包括《中国法学》《中外法学》《法学研究》《环球法律评论》《清华法学》《法学家》等中文法学期刊，以及多家法律出版社和中国知网。",
    rules: ["通常采用页下脚注。", "引注应必要、真实、相关、权威，优先引用原始出处。", "中文文献多用书名号；间接引用常用“参见”，转引应慎用并标明来源。"],
    examples: ["王名扬：《美国行政法》，北京大学出版社2007年版。", "季卫东：《法律程序的意义：对中国法制建设的另一种思考》，载《中国社会科学》1993年第1期。", "《民法典》第1165条第1款。"]
  },
  {
    title: "《中国法学》简化注释体例",
    source: "中国法学杂志社",
    url: "https://clsjp.chinalaw.org.cn/portal/list/index/id/1318.html",
    summary: "中国法学杂志社单列中文注释体例和外文引注规范简化版，适合投稿前作为格式核对入口。",
    rules: ["先按目标刊物发布的简化版体例统一中文与外文注释。", "中文文献核对作者、篇名、刊名、年份、期数和页码。", "外文文献同时注意期刊名、卷期、页码和法域习惯。"],
    examples: ["张文显：《法治与国家治理现代化》，《中国法学》2014年第4期，第18页。", "[美]富勒：《法律的道德性》，郑戈译，商务印书馆2005年版。"]
  },
  {
    title: "《中外法学》引证体例",
    source: "《中外法学》",
    url: "https://journal.pkulaw.cn/Home/Annotation",
    summary: "该体例明确采用脚注、每篇稿件编号连排，并对中文文献、外文文献、司法案例、法条和网络资料分别给出示例。",
    rules: ["注释信息一般按作者、文献名称、出版信息、页码排列。", "非直接引用原文前加“参见”；原则上少用转引。", "同一文献再次引用可用“同上注”或“见前注”。"],
    examples: ["苏力：《送法下乡——中国基层司法制度研究》（修订版），北京大学出版社2011年版，第55页。", "陈瑞华：“程序性制裁制度的法理学分析”，《中国法学》2005年第6期，第155页。", "王放与五洋建设集团股份有限公司、陈志樟证券虚假陈述责任纠纷案，浙江省杭州市中级人民法院民事判决书，（2020）浙01民初1691号。"]
  },
  {
    title: "《法律科学》注释体例",
    source: "《法律科学》",
    url: "https://flkx.nwupl.edu.cn/zzwd/146783.htm",
    summary: "该刊自2021年第1期起执行新的注释体例，并说明其他未尽事项以北京大学出版社2020年版《法学引注手册》为准。",
    rules: ["采用页下脚注、连续编号。", "期刊类作品标明作者、篇名、刊名、出版年、刊期和页码。", "网络文献应写明作者、文献名、网址及访问日期。"],
    examples: ["张文显：《法治与国家治理现代化》，《中国法学》2014年第4期，第18页。", "陈金钊：《国家治理体系法治化及其意义——兼论法律方法的功能》，载陈金钊、谢晖主编：《法律方法》（第15卷），山东人民出版社2014年版，第66页。"]
  },
  {
    title: "《法学家》等期刊的投稿体例入口",
    source: "《法学家》",
    url: "https://faxuejia.ruc.edu.cn/CN/column/7/items",
    summary: "《法学家》网站在下载中心提供本刊注释体例。实际投稿时，应以目标刊物最新公布版本为准。",
    rules: ["投稿前先下载目标刊物的注释体例。", "先统一脚注样式，再处理摘要、关键词、作者信息等投稿部件。", "不要把一个刊物的细节当然套用于另一个刊物。"],
